# Internal documentation, not part of the website.
#
# DEPLOYMENT.md names the server layout, the backup commands and which
# configuration values hold the credentials. None of it is secret by itself and
# all of it is reconnaissance for somebody probing the site.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
