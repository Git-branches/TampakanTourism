# =============================================================================
#  TourSync — document root configuration
# =============================================================================

Options -Indexes

# The "Apache/2.4.58 (Win64) OpenSSL/3.1.3 PHP/8.2.12" line that Apache adds to
# its own error pages names three products and their versions — enough to look
# up known vulnerabilities without touching the site. ServerTokens would trim
# the header too, but it is server-level; this is what a .htaccess can do.
ServerSignature Off

# Custom error pages. Without these the visitor sees an Apache default that
# names the server software and version — free reconnaissance for anyone
# probing the site.
#
# THESE PATHS ARE ABSOLUTE FROM THE SERVER ROOT, which is right when the site
# IS the server root (tourism.tampakan.gov.ph/) and wrong the moment it is not.
# On the office's own machine the site lives at /TampakanTourism/, so Apache
# looked for C:/xampp/htdocs/404.php, did not find it, and fell back to its own
# page — the default was on screen the whole time, naming Apache, OpenSSL and
# PHP with their version numbers. Measured in the error log, not guessed.
#
# They stay, because they are correct for the deployment that matters. The
# rewrite below covers the other case, so both are right either way.
ErrorDocument 404 /404.php
ErrorDocument 500 /500.php
ErrorDocument 403 /404.php


<IfModule mod_rewrite.c>
    RewriteEngine On

    # QR codes encode https://host/d/<32-hex-token>
    #
    # A path is used rather than a query string because the QR image is
    # printed on weather-exposed signage and scanned by whatever phone the
    # visitor has: fewer characters means a lower-density code, which stays
    # readable when scuffed, faded, or photographed at an angle.
    RewriteRule ^d/([a-f0-9]{32})/?$ d/index.php?token=$1 [L,QSA]

    # The same trade for tour guide IDs: https://host/g/<32-hex-token>
    #
    # It matters MORE here than on signage, not less. A guide's card is 2.63 in
    # wide and the code has perhaps 18 mm of it; the old address —
    # /guide-verify.php?id=<token> — was 69 characters, which at error level H
    # is a 49x49 grid, and 49 modules across 18 mm is 0.37 mm each. Every
    # character removed from the URL is a coarser, more forgiving code on a card
    # that lives in a pocket and gets rained on.
    RewriteRule ^g/([a-f0-9]{32})/?$ g/index.php?t=$1 [L,QSA]

    # ANYTHING ELSE THAT IS NOT THERE gets this site's own 404 page.
    #
    # A rewrite rather than another ErrorDocument, because a rewrite path is
    # relative to THIS file's directory: it is right whether the site is served
    # from a domain root or from a folder inside one, which is the case the
    # ErrorDocument lines above cannot cover. 404.php sends the 404 status
    # itself, so the answer is a real Not Found and not a 200 wearing its
    # clothes.
    #
    # Last, after the QR rules: those two name files that exist, so they match
    # and stop before reaching here.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ 404.php [L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Never serve the version-control or dependency metadata if it is ever present.
#
# THE FILE RULE WAS NOT ENOUGH. FilesMatch tests the file's own name, so
# "^\.git.*" matched a file called .gitignore and matched nothing at all inside
# the .git DIRECTORY — /.git/config, /.git/HEAD, /.git/index and /.git/logs/HEAD
# were all served with 200. That is the whole repository: the history can be
# reconstructed from those objects, and anything ever committed by mistake —
# a password, an API key — comes back with it, long after the file was deleted.
# Measured on this server before the rule below was added.
<FilesMatch "^(\.git.*|\.env.*|composer\.(json|lock)|package(-lock)?\.json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>

# Include-only PHP, by the naming this project already uses: every file whose
# name begins with an underscore is a fragment another page requires, never a
# page of its own.
#
# MEASURED, NOT ASSUMED. A crawl of every file in /admin, /manager and /api
# found three of them answering 200 on their own — and because a fragment runs
# without the bootstrap that defines the helpers, each died on its first e()
# call and printed "Fatal error … in C:\xampp\htdocs\…" to whoever asked. The
# files now refuse to run on their own as well (the defined('TOURSYNC') guard);
# this is the second lock, so a new fragment added later is covered by default.
<FilesMatch "^_.*\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# And the directories themselves, which the rule above cannot see.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.(git|svn|hg|idea|vscode)(/|$) - [F,L]
</IfModule>

<IfModule !mod_rewrite.c>
    RedirectMatch 404 /\.(git|svn|hg|idea|vscode)(/|$)
</IfModule>
